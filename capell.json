{
    "manifest-version": 3,
    "name": "capell-app/smart-404",
    "slug": "smart-404",
    "displayName": "Smart 404",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "preview",
    "description": "Adds a short list of close-matching pages to your not found page, chosen from live public pages in the same site and language.",
    "product": {
        "group": "Capell Search & SEO",
        "tier": "premium",
        "bundle": "search-seo"
    },
    "namespace": "Capell\\Smart404",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/discovery-foundation",
            "capell-app/frontend"
        ],
        "supports": ["capell-app/site-discovery"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Smart404\\Providers\\Smart404ServiceProvider"],
        "admin": ["Capell\\Smart404\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "route",
            "class": "Capell\\Smart404\\Manifest\\Smart404FrontendRoutesContribution",
            "routeNames": [
                "capell-smart-404.suggestions",
                "capell-smart-404.script",
                "capell-smart-404.styles"
            ]
        },
        {
            "type": "setting",
            "class": "Capell\\Smart404\\Manifest\\Smart404SettingsContribution",
            "settingsClass": "Capell\\Smart404\\Settings\\Smart404Settings",
            "settingsGroup": "smart_404",
            "settingsSchema": "Capell\\Smart404\\Filament\\Settings\\Smart404SettingsSchema"
        },
        {
            "type": "health-check",
            "class": "Capell\\Smart404\\Manifest\\Smart404HealthContribution",
            "checkClass": "Capell\\Smart404\\Health\\Smart404HealthCheck"
        },
        {
            "type": "frontend-component",
            "class": "Capell\\Smart404\\Manifest\\Smart404WidgetContribution",
            "view": "capell-smart-404::widget"
        }
    ],
    "database": {
        "migrationGroup": "content-product",
        "migrations": false,
        "settings": true,
        "requiredTables": ["settings", "pages", "sites"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "install": "Capell\\Smart404\\Actions\\InstallSmart404PackageAction",
        "resolveSuggestions": "Capell\\Smart404\\Actions\\ResolveSmart404SuggestionsAction"
    },
    "settings": ["Capell\\Smart404\\Settings\\Smart404Settings"],
    "permissions": [],
    "capabilities": ["frontend-surface"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [
                "GET /smart-404/smart-404.css (capell-smart-404.styles)",
                "GET /smart-404/smart-404.js (capell-smart-404.script)",
                "GET /smart-404/suggestions (capell-smart-404.suggestions)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /smart-404/suggestions (capell-smart-404.suggestions)"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 20,
        "cacheTags": ["smart-404"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "path"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "smart-404.suggestions",
            "label": "Smart 404 suggestions resolve from scoped public URLs.",
            "class": "Capell\\Smart404\\Health\\Smart404HealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Offers visitors on a not found page up to ten likely pages, matched to the address they asked for, with an on and off switch.",
        "description": "A visitor who mistypes /pricng still reaches the not found page, with Pricing offered as the likely page. Smart 404 lists pages that closely match the missing address. If too few match, it adds the nearest existing parent and the pages beneath it. Suggestions stay within the current site and language, and the page keeps its not found status. Set the number of links from 1 to 10 in the admin.",
        "problem": "Visitors who follow a missing link reach a dead end.",
        "outcome": "Visitors on a not found page see links to the nearest live pages.",
        "faq": [
            {
                "question": "Does a missing page still show as not found?",
                "answer": "Yes. The page keeps its not found status and visitors are not redirected. Suggestions only appear under the message."
            },
            {
                "question": "How many suggestions can I show?",
                "answer": "From 1 to 10, starting at five. Open Extensions in the admin and find Smart 404, where a switch turns it on or off and a number sets how many to show."
            },
            {
                "question": "Could it suggest a draft or hidden page?",
                "answer": "No. Suggestions come only from the same site and language, and always from live public pages that search engines are allowed to list."
            },
            {
                "question": "Does it work on a large site?",
                "answer": "Yes, with a limit. On larger sites only the first 250 public addresses, in alphabetical order, are searched."
            }
        ],
        "screenshots": [
            {
                "path": "docs/screenshots/smart-404-missing-page-desktop.png",
                "alt": "Page not found screen at desktop width with a search box and links to Homepage, Quick start and Browse extensions",
                "caption": "The not found page a visitor sees, here without a suggestions list.",
                "required": true
            },
            {
                "path": "docs/screenshots/smart-404-missing-page-mobile.png",
                "alt": "Page not found screen at phone width with a search box, four links and a diagram below",
                "caption": "The same not found page on a phone, laid out for a narrow screen.",
                "required": true
            },
            {
                "path": "docs/screenshots/smart-404-settings.png",
                "alt": "Smart 404 settings panel with an Enable switch turned on and a Maximum suggestions field set to 5",
                "caption": "Turn suggestions on or off and set how many to show.",
                "required": true
            }
        ],
        "categories": ["frontend", "search-seo"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "admin-page",
                "key": "extension-management-surface:capell-app/smart-404:settings:smart_404",
                "providerBucket": "admin"
            },
            {
                "type": "render-hook",
                "key": "smart-404-widget",
                "providerBucket": "runtime"
            }
        ]
    }
}
